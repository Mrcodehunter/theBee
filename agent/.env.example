# Copy this file to .env (in this agent/ folder) and fill in what you need.
# .env is gitignored — safe to put real secrets here.
#
# Every model in the picker needs its own key — set at least one or the
# agent has nothing to talk to. All of these have a free tier.

# Ollama Cloud (default model) — sign in / create a key at
# https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Google Gemini — free tier via Google AI Studio:
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Groq — free tier: https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter — free ":free"-suffixed models: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Claude — paid, no free tier. Get a key at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional — sandbox the agent to a different project directory.
# AGENT_PROJECT_DIR=C:\path\to\your\project
